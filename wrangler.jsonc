{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topperbus",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths fall back to index.html so React Router can handle them
    "not_found_handling": "single-page-application",
    // Only API requests hit the Worker; everything else is served straight from static assets
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    // Jan 1, 15:00 UTC (9 or 10 AM Central): yearly academic calendar reminder
    "crons": ["0 15 1 1 *"]
  },
  "observability": {
    "enabled": true
  }
}
